ZonePanel {
    background-color: #121920;
    border-left: 1px solid #1e293b;
}

QPushButton#primaryAction {
    background-color: #0d9488;
    border-color: #0d9488;
    color: #ffffff;
}

QPushButton#primaryAction:hover {
    background-color: #14b8a6;
    border-color: #14b8a6;
    color: #ffffff;
}

QPushButton#primaryAction:pressed {
    background-color: #0f766e;
    border-color: #0f766e;
    color: #ffffff;
}

QPushButton#primaryAction:disabled {
    background-color: #1e3a38;
    border-color: #1e3a38;
    color: #64748b;
}

QPushButton#apply {
    background-color: #0d9488;
    border-color: #0d9488;
    color: #ffffff;
}

QPushButton#apply:hover {
    background-color: #14b8a6;
    border-color: #14b8a6;
    color: #ffffff;
}

QPushButton#cancel {
    background-color: #1a2330;
    color: #cbd5e1;
    border-color: #334155;
}

QLabel#editLabel {
    font-size: 12px;
    line-height: 1.4;
    color: #fbbf24;
    background-color: #292524;
    border: 1px solid #78350f;
    border-radius: 6px;
    padding: 10px 12px;
}

QLabel#title {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.8px;
    color: #94a3b8;
    padding-top: 4px;
}

QLabel#hint {
    font-size: 11px;
    color: #64748b;
    padding: 4px 2px 0 2px;
}

QComboBox#levelCombo {
    font-size: 13px;
    font-weight: 600;
    padding: 6px 10px;
    border: 1px solid #334155;
    border-radius: 6px;
    background-color: #1a2330;
    color: #e2e8f0;
    min-height: 28px;
}

QComboBox#levelCombo:hover {
    border-color: #475569;
}

QComboBox#levelCombo::drop-down {
    border: none;
    width: 24px;
}

QComboBox#levelCombo QAbstractItemView {
    background-color: #1a2330;
    border: 1px solid #334155;
    color: #e2e8f0;
    selection-background-color: #0d9488;
    selection-color: #ffffff;
    padding: 4px;
}

QLineEdit#nameEdit {
    font-size: 13px;
    padding: 7px 10px;
    border: 1px solid #334155;
    border-radius: 6px;
    background-color: #1a2330;
    color: #e2e8f0;
    min-height: 28px;
}

QLineEdit#nameEdit:focus {
    border-color: #2dd4bf;
}

QLineEdit#nameEdit:disabled {
    background-color: #151c26;
    color: #64748b;
}

QComboBox#levelCombo:disabled {
    background-color: #151c26;
    color: #64748b;
}

QListWidget {
    background-color: #1a2330;
    font-size: 13px;
    color: #e2e8f0;
    border: 1px solid #334155;
    border-radius: 8px;
    padding: 4px;
    outline: none;
}

QListWidget::item {
    padding: 10px 12px;
    margin: 2px;
    border-radius: 6px;
}

QListWidget::item:hover {
    background-color: #243041;
}

QListWidget::item:selected {
    background-color: #0f766e;
    color: #ecfdf5;
}
