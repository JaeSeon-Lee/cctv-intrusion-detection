ControlBar {
    background-color: #141c27;
    border-top: 1px solid #243041;
}

ControlBar QPushButton {
    min-width: 72px;
}

ControlBar QPushButton#playButton {
    background-color: #0d9488;
    border-color: #0d9488;
    color: #ffffff;
    min-width: 88px;
}

ControlBar QPushButton#playButton:hover {
    background-color: #14b8a6;
    border-color: #14b8a6;
    color: #ffffff;
}

ControlBar QPushButton#playButton:pressed {
    background-color: #0f766e;
    border-color: #0f766e;
}

ControlBar QPushButton#playButton:disabled {
    background-color: #1e3a38;
    border-color: #1e3a38;
    color: #64748b;
}

QLabel#timeLabel {
    font-size: 12px;
    font-weight: 600;
    color: #94a3b8;
    min-width: 96px;
    padding: 0 4px;
}

QSlider::groove:horizontal {
    height: 6px;
    background: #334155;
    border-radius: 3px;
}

QSlider::sub-page:horizontal {
    background: #2dd4bf;
    border-radius: 3px;
}

QSlider::add-page:horizontal {
    background: #334155;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    width: 16px;
    height: 16px;
    margin: -6px 0;
    background: #f8fafc;
    border: 2px solid #2dd4bf;
    border-radius: 8px;
}

QSlider::handle:horizontal:hover {
    background: #ccfbf1;
}

QSlider::handle:horizontal:disabled {
    border-color: #64748b;
}
